{
    "name": "tobento/app-crud",
    "version": "2.0",
    "type": "library",
    "description": "App CRUD.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "crud"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app-event": "^2.0",
        "tobento/app-html-sanitizer": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-media": "^2.0",
        "tobento/app-message": "^2.0",
        "tobento/app-language": "^2.0",
        "tobento/app-slugging": "^2.0",
        "tobento/app-translation": "^2.0",
        "tobento/app-validation": "^2.0",
        "tobento/app-view": "^2.0",
        "tobento/service-tag": "^2.0",
        "tobento/service-iterable": "^2.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-support": "^2.0",
        "tobento/service-autowire": "^2.0",
        "tobento/service-repository": "^2.0",
        "tobento/service-pagination": "^2.0",
        "tobento/service-validation": "^2.0",
        "tobento/service-uri": "^2.0",
        "tobento/service-menu": "^2.0",
        "tobento/js-editor": "^1.0",
        "tobento/js-notifier": "^1.0",
        "tobento/js-sortable": "^1.0",
        "tobento/css-modal": "^1.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-acl": "^2.0",
        "tobento/service-repository-storage": "^2.0",
        "tobento/service-storage": "^2.0",
        "tobento/service-seeder": "^2.0",
        "tobento/app-database": "^2.0",
        "tobento/app-testing": "^2.0",
        "tobento/app-user": "^2.0",
        "tobento/app-profiler": "^2.0",
        "tobento/app-file-storage": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "tobento/service-imager": "^2.0",
        "tobento/app-logging": "^2.0",
        "league/mime-type-detection": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Crud\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Crud\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}